# `bundle exec vite` rather than `bin/vite` so the Vite dev server starts
# regardless of how the Bundler binstubs were generated.
vite: bundle exec vite dev
# MESSAGEBIRD_FAKE_OTP skips the SMS and accepts one fixed code, so the
# verification screen can be driven without a MessageBird key.
#
# SERVER_HOST feeds config.action_mailer.default_url_options, and the mailers
# build absolute links with *_url. Offering a swap sends UserMailer#confirm_swap
# inline (User#swap_with_user_id calls deliver_now), so without a host that
# request raises "Missing host to link to!" and POST /api/v1/swap 500s. Anyone
# who has not copied .env.example to .env — including CI, which boots this
# Procfile — would hit that on the swap flow's happy path, so default it here.
# `:-` only fills in when the variable is unset, so a real .env still wins.
web: SERVER_HOST=${SERVER_HOST:-localhost} SERVER_HOST_PORT=${SERVER_HOST_PORT:-localhost:3000} MESSAGEBIRD_FAKE_OTP=123456 bin/rails s -p 3000
